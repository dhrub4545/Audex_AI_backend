{
  "version": 2,
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    },
    "server.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "crons": [
    {
      "path": "/api/audits/cron/sync",
      "schedule": "0 0 * * *"
    }
  ]
}
